      "source": [
        "import json\n",
        "import tarfile\n",
        "import zipfile\n",
        "import os\n",
        "\n",
        "p = hf_hub_download(REPO, SPOTS_JSON, repo_type=\"dataset\")\n",
        "\n",
        "# Safely handle archive extraction if the file is compressed\n",
        "if p.endswith(\".tar.xz\") or p.endswith(\".xz\") or p.endswith(\".tar.gz\") or p.endswith(\".tar\"):\n",
        "    print(f\"Extracting archive: {p}\")\n",
        "    with tarfile.open(p, \"r:*\") as tar:\n",
        "        tar.extractall(path=\"extracted_annotations\")\n",
        "    # Find the extracted JSON files\n",
        "    extracted_files = []\n",
        "    for root, dirs, files_in_dir in os.walk(\"extracted_annotations\"):\n",
        "        for f in files_in_dir:\n",
        "            if f.endswith(\".json\"):\n",
        "                extracted_files.append(os.path.join(root, f))\n",
        "    if extracted_files:\n",
        "        target_json = extracted_files[0]\n",
        "        print(f\"Found extracted JSON: {target_json}\")\n",
        "        coco = json.load(open(target_json))\n",
        "    else:\n",
        "        raise ValueError(\"No JSON files found inside the extracted archive.\")\n",
        "elif p.endswith(\".zip\"):\n",
        "    print(f\"Extracting zip archive: {p}\")\n",
        "    with zipfile.ZipFile(p, \"r\") as zip_ref:\n",
        "        zip_ref.extractall(\"extracted_annotations\")\n",
        "    # Find the extracted JSON files\n",
        "    extracted_files = []\n",
        "    for root, dirs, files_in_dir in os.walk(\"extracted_annotations\"):\n",
        "        for f in files_in_dir:\n",
        "            if f.endswith(\".json\"):\n",
        "                extracted_files.append(os.path.join(root, f))\n",
        "    if extracted_files:\n",
        "        target_json = extracted_files[0]\n",
        "        print(f\"Found extracted JSON: {target_json}\")\n",
        "        coco = json.load(open(target_json))\n",
        "    else:\n",
        "        raise ValueError(\"No JSON files found inside the extracted ZIP.\")\n",
