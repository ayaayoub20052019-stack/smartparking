      ],
      "source": [
        "from huggingface_hub import list_repo_files, hf_hub_download\n",
        "\n",
        "REPO = \"DSBD-Research/MetaPKLot-Dataset\"\n",
        "try:\n",
        "    files = list_repo_files(REPO, repo_type=\"dataset\")\n",
        "except Exception as e:\n",
        "    print(f\"Error connecting to Hugging Face Hub: {e}\")\n",
        "    files = []\n",
        "\n",
        "jsons = [f for f in files if f.endswith(\".json\")]\n",
        "print(f\"Found {len(files)} files in repo; {len(jsons)} JSON files.\")\n",
        "\n",
        "if jsons:\n",
        "    print(\"JSON files available:\")\n",
        "    for f in jsons[:10]:\n",
        "        print(\"  \", f)\n",
        "    if len(jsons) > 10:\n",
        "        print(\"  ... and others\")\n",
        "else:\n",
        "    print(\"Note: No files ending directly with '.json' were discovered in this repository.\")"
      ],
      "id": "jcx9_wffEjWB"
    },
