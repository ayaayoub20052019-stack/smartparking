      },
      "source": [
        "import os\n",
        "import shutil\n",
        "from google.colab import files\n",
        "\n",
        "# Create a clean directory for just the original unedited full images\n",
        "os.makedirs(\"original_images\", exist_ok=True)\n",
        "\n",
        "# Copy each downloaded original image from our local cache map into this folder with its original filename style\n",
        "for img_id, cached_path in local.items():\n",
        "    img_meta = next(im for im in coco[\"images\"] if im[\"id\"] == img_id)\n",
        "    original_name = os.path.basename(img_meta[\"file_name\"])\n",
        "    dest_path = os.path.join(\"original_images\", f\"{img_id}_{original_name}\")\n",
        "    shutil.copy(cached_path, dest_path)\n",
        "\n",
        "# Zip the folder containing only the original, unedited full images\n",
        "shutil.make_archive(\"original_parking_lot_images\", \"zip\", \"original_images\")\n",
        "\n",
        "print(\"Package created successfully! Your download should start shortly.\")\n",
        "# Trigger the download to your desktop\n",
        "files.download(\"original_parking_lot_images.zip\")"
      ],
