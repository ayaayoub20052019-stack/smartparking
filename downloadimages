      ],
      "source": [
        "# Search for possible annotation files safely\n",
        "spots = [f for f in jsons if \"spots\" in f.lower()]\n",
        "pk = [f for f in spots if \"pklot\" in f.lower()]\n",
        "\n",
        "SPOTS_JSON = None\n",
        "\n",
        "if pk or spots:\n",
        "    SPOTS_JSON = (pk or spots)[0]\n",
        "    print(\"Using automatically selected annotation file:\", SPOTS_JSON)\n",
        "else:\n",
        "    # Fallback to general annotation archives\n",
        "    fallback_candidates = [f for f in files if any(ext in f.lower() for ext in [\"json\", \"annotation\", \"xml\", \"tar.xz\", \"zip\"])]\n",
        "    if fallback_candidates:\n",
        "        SPOTS_JSON = fallback_candidates[0]\n",
        "        print(f\"No standard '.json' spots found. Falling back to the first potential archive: {SPOTS_JSON}\")\n",
        "    else:\n",
        "        print(\"Warning: No valid dataset annotation files or fallback candidates could be identified.\")"
      ],
