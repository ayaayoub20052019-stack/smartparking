      "id": "aTEkeLLtEjWA"
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "jcx9_wffEjWB",
        "outputId": "2c95541c-9ab1-4a7b-c3d9-21d1533e93da"
      },
      "execution_count": 26,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
