        "## 3. Pick 100 random images and download them"
      ],
      "id": "wCXpPhJiEjWC"
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "k_VOOPpUEjWC",
        "outputId": "cb2bcb75-db52-40b3-adea-5fdb92649a2a"
      },
      "execution_count": 29,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "downloaded 100 images\n"
          ]
        }
      ],
      "source": [
        "import random, collections, os\n",
        "from PIL import Image\n",
        "\n",
        "by_img = collections.defaultdict(list)\n",
        "for a in coco[\"annotations\"]:\n",
        "    by_img[a[\"image_id\"]].append(a)\n",
        "\n",
        "imgs = [im for im in coco[\"images\"] if im[\"id\"] in by_img]\n",
        "random.seed(42)\n",
        "sample = random.sample(imgs, 100)\n",
        "\n",
        "# map \"UFPR04/Rainy/2012-12-07/x.jpg\" -> its real path inside the repo\n",
        "tail = lambda s: \"/\".join(s.split(\"/\")[-4:])\n",
        "index = {tail(f): f for f in files if f.lower().endswith(\".jpg\")}\n",
        "\n",
        "os.makedirs(\"samples\", exist_ok=True)\n",
        "local = {}\n",
        "for i, im in enumerate(sample):\n",
        "    repo_path = index.get(tail(im[\"file_name\"]))\n",
        "    if repo_path is None:\n",
        "        print(\"not found in repo:\", im[\"file_name\"]); continue\n",
        "    local[im[\"id\"]] = hf_hub_download(REPO, repo_path, repo_type=\"dataset\")\n",
        "print(\"downloaded\", len(local), \"images\")"
      ],
      "id": "k_VOOPpUEjWC"
    },
