"""
Parking space occupancy classifier (vacant vs occupied), mAlexNet-style CNN.

Expected folder layout (patches cropped per parking space):
    data/
      train/
        free/      *.jpg
        busy/      *.jpg
      val/
        free/
        busy/

Install:  pip install torch torchvision
Run:      python parking_cnn.py
"""
import torch
import torch.nn as nn
from torch.utils.data import DataLoader
from torchvision import datasets, transforms

DEVICE = "cuda" if torch.cuda.is_available() else "cpu"


class SmallAlexNet(nn.Module):
    """Compact AlexNet-like CNN (3 conv layers + 2 fully connected)."""

    def __init__(self, num_classes=2):
        super().__init__()
        self.features = nn.Sequential(
            nn.Conv2d(3, 16, kernel_size=11, stride=4),
            nn.ReLU(),
            nn.MaxPool2d(3, stride=2),
            nn.Conv2d(16, 20, kernel_size=5, padding=2),
            nn.ReLU(),
            nn.MaxPool2d(3, stride=2),
            nn.Conv2d(20, 30, kernel_size=3, padding=1),
            nn.ReLU(),
            nn.MaxPool2d(3, stride=2),
        )
        self.classifier = nn.Sequential(
            nn.Flatten(),
            nn.LazyLinear(48),
            nn.ReLU(),
            nn.Dropout(0.5),
            nn.Linear(48, num_classes),
        )

    def forward(self, x):
        return self.classifier(self.features(x))


def get_loaders(root="data", batch_size=64):
    train_tf = transforms.Compose([
        transforms.Resize((224, 224)),
        transforms.RandomHorizontalFlip(),
        transforms.ColorJitter(brightness=0.3, contrast=0.3),
        transforms.ToTensor(),
    ])
    val_tf = transforms.Compose([
        transforms.Resize((224, 224)),
        transforms.ToTensor(),
    ])
    train_ds = datasets.ImageFolder(f"{root}/train", train_tf)
    val_ds = datasets.ImageFolder(f"{root}/val", val_tf)
    print("Classes:", train_ds.class_to_idx)
    return (
        DataLoader(train_ds, batch_size, shuffle=True, num_workers=2),
        DataLoader(val_ds, batch_size, num_workers=2),
    )


def evaluate(model, loader):
    model.eval()
    correct = total = 0
    with torch.no_grad():
        for x, y in loader:
            x, y = x.to(DEVICE), y.to(DEVICE)
            correct += (model(x).argmax(1) == y).sum().item()
            total += y.size(0)
    return correct / total


def train(epochs=10, lr=1e-3):
    train_loader, val_loader = get_loaders()
    model = SmallAlexNet().to(DEVICE)
    model(torch.zeros(1, 3, 224, 224, device=DEVICE))  # init lazy layer

    opt = torch.optim.Adam(model.parameters(), lr=lr)
    loss_fn = nn.CrossEntropyLoss()

    for epoch in range(epochs):
        model.train()
        running = 0.0
        for x, y in train_loader:
            x, y = x.to(DEVICE), y.to(DEVICE)
            opt.zero_grad()
            loss = loss_fn(model(x), y)
            loss.backward()
            opt.step()
            running += loss.item()
        acc = evaluate(model, val_loader)
        print(f"Epoch {epoch+1}/{epochs}  loss={running/len(train_loader):.4f}  val_acc={acc:.4f}")

    torch.save(model.state_dict(), "parking_cnn.pt")
    return model


def predict_patch(model, image_path, class_names=("busy", "free")):
    """Classify one cropped parking-space image."""
    from PIL import Image
    tf = transforms.Compose([transforms.Resize((224, 224)), transforms.ToTensor()])
    x = tf(Image.open(image_path).convert("RGB")).unsqueeze(0).to(DEVICE)
    model.eval()
    with torch.no_grad():
        return class_names[model(x).argmax(1).item()]


if __name__ == "__main__":
    train()
